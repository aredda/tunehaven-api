#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../config/environment'
require "googleauth"
require "google/cloud/pubsub"
require "google/cloud/storage"

$stdout.sync = true
$stderr.sync = true

ENV["GOOGLE_CLOUD_CREDENTIALS"] = ENV.fetch("GCS_JSON_KEY")

pubsub = Google::Cloud::PubSub.new

# Connect to the bucket
storage = Google::Cloud::Storage.new
bucket = storage.bucket ENV.fetch("GCS_BUCKET_NAME"), skip_lookup: true

# Get a subscriber for a subscription
subscriber = pubsub.subscriber ENV.fetch("GCS_SUBSCRIPTION")

# Create a listener to listen for available messages
# By default, this block will be called on 8 concurrent threads.
# This can be changed with the :threads option
listener = subscriber.listen do |received_message|
  event = received_message.message.attributes["eventType"]
  filename = JSON.parse(received_message.message.data)["name"]

  operation = case event
  when "OBJECT_DELETE"
    PubSub::Operation::Destroy
  else
    PubSub::Operation::Create
  end

  result = operation.(bucket:, notification: received_message)

  if result.success?
    puts "[#{Time.now.strftime("%m/%d/%Y %I:%M%p")}] - [#{event}] - [#{filename}]"

    # Log the event
    Platform::Log::StorageSubEvent.create(
      event_type: event,
      filename:,
      state: :succeeded
    )
  end

  ensure
    received_message.acknowledge!
end

# Handle exceptions from listener
listener.on_error do |exception|
  puts "Exception: #{exception.class} #{exception.message}"
end

# Gracefully shut down the subscriber on program exit, blocking until
# all received messages have been processed or 10 seconds have passed
at_exit do
  listener.stop!(10)
end

# Start background threads that will call the block passed to listen.
listener.start

puts "Listening to events..."

sleep
